#!/bin/sh
# /etc/init.d/fbdash - start the OMA//DASH framebuffer renderer at boot
# fbdash itself takes an exclusive flock on /dev/fb0, so a second copy (a test
# build in /tmp, a stale binary) exits instead of fighting for the panel.
BIN=/mnt/fs_user/fbdash
LOG=/tmp/fbdash.log

case "$1" in
  start)
    [ -x "$BIN" ] || { echo "fbdash: $BIN missing or not executable" >&2; exit 1; }
    ($BIN >>"$LOG" 2>&1 &)
    sleep 1
    if pidof fbdash >/dev/null; then
        echo "fbdash: started pid $(pidof fbdash)"
    else
        echo "fbdash: failed to start - /dev/fb0 already owned by another process?" >&2
        tail -n 3 "$LOG" 2>/dev/null >&2
        exit 1
    fi
    ;;
  stop)
    kill $(pidof fbdash) 2>/dev/null
    ;;
  restart)
    "$0" stop; sleep 1; "$0" start
    ;;
  *)
    echo "usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
